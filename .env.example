# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/genesis_ai

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this

# AI Providers (add keys for the providers you want to use)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
MISTRAL_API_KEY=your-mistral-api-key
XAI_API_KEY=your-xai-api-key

# Optional model-name overrides
ANTHROPIC_CLAUDE_SONNET_46_MODEL=claude-sonnet-4-6-latest
MISTRAL_DEFAULT_MODEL=mistral-large-latest
XAI_DEFAULT_MODEL=grok-3

# Optional provider base URL overrides
MISTRAL_BASE_URL=https://api.mistral.ai/v1
XAI_BASE_URL=https://api.x.ai/v1

# GitHub OAuth Setup Instructions:
# 1. Go to https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Fill in Application name: "Genesis AI"
# 4. Set Homepage URL: http://localhost:5173 (or your frontend URL)
# 5. Set Authorization callback URL: http://localhost:5000/api/auth/callback/github (or your backend URL)
#    - For production: https://yourdomain.com/api/auth/callback/github
# 6. Copy Client ID and Client Secret from the app settings
# 7. Update GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET below
# Important: The redirect URI MUST exactly match what you set in GitHub OAuth app settings
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Optional: explicitly set the redirect URI (if not set, server will construct from request headers)
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/callback/github

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback/google

# Vercel
VERCEL_TOKEN=your-vercel-token

# Render
RENDER_API_KEY=your-render-api-key

# App
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# Email (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_METHOD=password
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="Genesis.ai <no-reply@genesis.ai>"

# Google OAuth2 mail (set SMTP_AUTH_METHOD=oauth2 to use this instead of SMTP_PASS)
SMTP_SERVICE=gmail
SMTP_CLIENT_ID=your-google-oauth-client-id
SMTP_CLIENT_SECRET=your-google-oauth-client-secret
SMTP_REFRESH_TOKEN=your-google-oauth-refresh-token