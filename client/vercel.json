{
	"version": 2,
	"framework": "vite",
	"installCommand": "npm ci",
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": "https://genesis-ai-tu97.vercel.app/api/$1"
		},
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	]
}
